# Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.

# -------------------------------------------------------------------
# Supabase (Frontend — safe to expose, scoped by Row Level Security)
# -------------------------------------------------------------------
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# -------------------------------------------------------------------
# Supabase Edge Function Secrets
# Set these in: Supabase Dashboard → Project Settings → Edge Functions → Secrets
# OR via: supabase secrets set KEY=value
# -------------------------------------------------------------------

# Your Supabase project reference ID (e.g. "abcdefghijklmnop")
SUPABASE_URL=YOUR_PROJECT_REF

# Service Role Key — grants full DB access. Keep this secret!
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# API key for the endpoint you are monitoring
ANTHROPIC_AUTH_TOKEN=your_api_key_here
